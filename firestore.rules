rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256;
    }

    // Validation for SavedItem
    function isValidSavedItem(data) {
      return data.keys().hasAll(['id', 'userId', 'category', 'title'])
        && data.keys().hasOnly(['id', 'userId', 'category', 'title', 'data', 'previewImage', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.category is string && data.category.size() <= 64
        && data.title is string && data.title.size() <= 150;
    }

    // Validation for KidProgress
    function isValidKidProgress(data) {
      return data.keys().hasAll(['userId'])
        && data.keys().hasOnly(['userId', 'kidName', 'stars', 'completedModules', 'lastActive'])
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // User saved items (cards, letters, photos, etc.)
      match /savedItems/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidSavedItem(incoming());
        allow update: if isOwner(userId) && isValidId(itemId) && isValidSavedItem(incoming());
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // User kid progress tracking
      match /kidProgress/{progressId} {
        allow get: if isOwner(userId) && isValidId(progressId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(progressId) && isValidKidProgress(incoming());
        allow update: if isOwner(userId) && isValidId(progressId) && isValidKidProgress(incoming());
        allow delete: if isOwner(userId) && isValidId(progressId);
      }
    }
  }
}
